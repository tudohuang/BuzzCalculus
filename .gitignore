# 產生出來的東西：都能重跑
tmp/
brag-output*/
*.synctex.gz
*.aux
*.fls
*.fdb_latexmk

# 不進版控：內部報告、DM、退休頁、產生的報表、錄影素材、助理的工作目錄
.claude/
docs/report/
docs/dm/
docs/retired/
docs/trailer/
reports/

# 螢幕錄影與成片都不進版控
*.mp4
*.mov

# Manim 動畫：渲染產物與本機 venv（venv 平常放在 WSL 家目錄）
manim/out/
manim/.venv/
manim/**/__pycache__/

# 課程影片：只有清單進 git，影片在 Release、部署時由 tools/fetch_media.js 抓
media/*
!media/manifest.json

# 本機金鑰（Azure 語音等），絕不進版控
azure*.txt
