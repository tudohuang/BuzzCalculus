      ]
    },
    {
      "ask": "$\\ln(x - 2)$ 的定義域？",
      "options": [
        { "label": "$x \\ge 2$", "why": "$x = 2$ 時是 $\\ln 0$，沒有定義；$e$ 的任何次方都不是 0。" },
        { "label": "所有實數", "why": "對數只吃正數，$x - 2$ 要大於 0。" },
        { "label": "$x > 2$", "correct": true }
      ]
    }
  ],
