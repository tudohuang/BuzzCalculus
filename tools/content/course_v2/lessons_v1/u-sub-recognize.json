    {
      "title": "看出是 $\\arctan$",
      "prompt": "$\\int\\frac{x}{x^4+1}\\,dx$",
      "problemId": "exam-int-018",
      "steps": [
        "分母 $x^4+1=1+(x^2)^2$：形狀是 $1+u^2$，$u=x^2$。",
        "$du=2x\\,dx$，所以 $x\\,dx=\\frac{du}{2}$。",
        "$\\int\\frac{x}{x^4+1}\\,dx=\\frac{1}{2}\\int\\frac{du}{1+u^2}=\\frac{1}{2}\\arctan u+C$。",
        "答案：$\\frac{1}{2}\\arctan(x^2)+C$。"
      ],
      "answer": "$\\frac{1}{2}\\arctan(x^2)+C$",
      "claim": "D(atan(x^2)/2) == x/(x^4+1)"
    },
    {
      "title": "兩種選法，答案差常數",
      "prompt": "$\\int\\sin x\\cos x\\,dx$",
      "steps": [
        "選法一：$u=\\sin x$，$du=\\cos x\\,dx$。$\\int u\\,du=\\frac{u^2}{2}$，得 $\\frac{\\sin^2 x}{2}+C$。",
        "選法二：$u=\\cos x$，$du=-\\sin x\\,dx$。$-\\int u\\,du=-\\frac{u^2}{2}$，得 $-\\frac{\\cos^2 x}{2}+C$。",
        "兩者相減：$\\frac{\\sin^2 x}{2}-\\left(-\\frac{\\cos^2 x}{2}\\right)=\\frac{\\sin^2 x+\\cos^2 x}{2}=\\frac{1}{2}$，是常數。兩個都是正確答案。"
      ],
      "answer": "$\\frac{\\sin^2 x}{2}+C$（或 $-\\frac{\\cos^2 x}{2}+C$）",
      "claim": "D(sin(x)^2/2) == sin(x)*cos(x) ;; sin(x)^2/2 ~= -cos(x)^2/2"
    }
