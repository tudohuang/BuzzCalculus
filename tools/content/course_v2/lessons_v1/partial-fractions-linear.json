    {
      "ask": "承上，$A$ 是？",
      "options": [
        { "label": "$\\frac{1}{4}$", "correct": true },
        { "label": "$1$", "why": "遮住 $x-1$ 後，剩下的 $\\frac{1}{x+3}$ 還要代 $x=1$：$\\frac{1}{4}$。" },
        { "label": "$-\\frac{1}{4}$", "why": "那是 $B$：遮住 $x+3$，把 $x=-3$ 代進 $\\frac{1}{x-1}$ 得 $-\\frac{1}{4}$。" }
      ]
    },
    {
      "ask": "$\\int \\frac{x^2+1}{x^2-1}\\,dx$ 的第一步？",
      "options": [
        { "label": "長除法", "correct": true },
        { "label": "直接設 $\\frac{A}{x-1}+\\frac{B}{x+1}$", "why": "分子分母同次，這樣設會漏掉整式部分 $1$，解不出一致的 $A$、$B$。" },
        { "label": "令 $u=x^2-1$", "why": "$du=2x\\,dx$，分子是 $x^2+1$，配不起來。" }
