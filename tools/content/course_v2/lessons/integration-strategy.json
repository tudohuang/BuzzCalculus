        "I=\\int_0^{\\pi/2}\\frac{\\cos x}{\\cos x+\\sin x}\\,dx",
        "2I=\\int_0^{\\pi/2}\\frac{\\sin x+\\cos x}{\\sin x+\\cos x}\\,dx=\\frac\\pi2",
        "I=\\frac\\pi4"
      ]
