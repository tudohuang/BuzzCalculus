      ],
      "tex": [
        "x(t)^2+y(t)^2=25\\quad\\text{（每個時刻都成立）}",
        "2x\\frac{dx}{dt}+2y\\frac{dy}{dt}=0",
        "2(3)(1)+2(4)\\frac{dy}{dt}=0",
        "\\frac{dy}{dt}=-\\frac68=-\\frac34\\ \\text{m/s}"
      ]
