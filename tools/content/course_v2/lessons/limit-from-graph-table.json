  "workedExamples": [
    {
      "title": "用表格估計",
      "prompt": "估計 $\\lim_{x\\to2} \\frac{x^3 - 8}{x - 2}$",
      "steps": [
        "$x = 2$ 代不進去（$\\frac{0}{0}$），從兩邊取點。",
        "$x = 1.9$、1.99、1.999：值 11.41、11.9401、11.994001。",
        "$x = 2.1$、2.01、2.001：值 12.61、12.0601、12.006001。",
        "兩邊都往 12 靠，估計極限是 12。〈0/0：因式分解〉會用 $x^3 - 8 = (x - 2)(x^2 + 2x + 4)$ 證實它。"
      ],
      "answer": "12",
      "claim": "LIM((x^3-8)/(x-2), 2) == 12 ;; SUB((x^3-8)/(x-2), 1.99) == 11.9401 ;; SUB((x^3-8)/(x-2), 2.001) == 12.006001"
    },
    {
      "title": "讀跳躍",
      "prompt": "$f$ 的圖形：$x < 1$ 時是通過 $(-1, 0)$ 與 $(1, 2)$ 的直線，在 $(1, 2)$ 畫空心點；$x \\ge 1$ 時是 $y = x - 1$，在 $(1, 0)$ 畫實心點。求左右極限、極限與 $f(1)$。",
      "steps": [
        "左段通過 $(-1, 0)$、$(1, 2)$，斜率 1，是 $y = x + 1$。從左邊走到 $x = 1$，高度靠近 2：左極限 2。",
        "右段 $y = x - 1$，從右邊走到 $x = 1$，高度靠近 0：右極限 0。",
        "$2 \\ne 0$，$\\lim_{x\\to1} f(x)$ 不存在。",
        "實心點在 $(1, 0)$：$f(1) = 0$。"
      ],
      "answer": "左極限 2，右極限 0，極限不存在，$f(1) = 0$",
      "claim": "LIM(x+1, 1-) == 2 ;; LIM(x-1, 1+) == 0 ;; SUB(x+1, -1) == 0"
    },
    {
      "title": "數字一路變大",
      "prompt": "$h(x) = \\frac{1}{(x - 3)^2}$。從表格判斷 $x \\to 3$ 時的行為。",
      "steps": [
        "$x = 2.99$ 或 3.01：$(x - 3)^2 = 0.0001$，$h = 10000$。",
        "$x = 2.999$ 或 3.001：$(x - 3)^2 = 0.000001$，$h = 1000000$。",
        "越靠近 3 越大，而且沒有上限：不靠近任何數，極限不存在（往 $+\\infty$）。圖形在 $x = 3$ 有垂直漸近線。"
      ],
      "answer": "不存在，兩側都往 $+\\infty$",
      "claim": "SUB(1/(x-3)^2, 2.99) == 10000 ;; SUB(1/(x-3)^2, 3.001) == 1000000 ;; LIM((x-3)^2, 3) == 0"
    }
  ],
  "pitfalls": [
    "把實心點的高度（$f(a)$）當成極限。",
