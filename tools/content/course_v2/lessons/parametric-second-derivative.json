  "objectives": [
    "用 $\\frac{d^2y}{dx^2}=\\left[\\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)\\right]\\Big/\\frac{dx}{dt}$ 求參數曲線的二階導數",
    "避開最常見的錯：把 $\\frac{d^2y}{dx^2}$ 寫成 $\\frac{d^2y/dt^2}{d^2x/dt^2}$",
    "用二階導數的正負判斷參數曲線往上彎還是往下彎"
  ],
  "visual": null,
  "concept": [
    {
      "heading": "① 斜率對 $x$ 的變化率",
      "body": [
        "• 正的：往右走，斜率變大 → 凹向上",
        "• 負的：往右走，斜率變小 → 凹向下",
        "重點是對 $x$，不是對 $t$"
      ],
      "tex": [
        "\\frac{d^2y}{dx^2}=\\frac{d}{dx}\\left(\\frac{dy}{dx}\\right)"
      ]
    },
    {
      "heading": "② 把 $\\frac{dy}{dx}$ 當成新的 $y$",
      "body": [
        "令 $m(t)=\\dfrac{dy}{dx}$（它也是 $t$ 的函數）",
        "要的是 $\\dfrac{dm}{dx}$：對 $m$ 用上一課的公式",
        "三步：",
        "1. 算 $\\dfrac{dy}{dx}$（寫成 $t$ 的式子）",
        "2. 對 $t$ 微分",
        "3. 除以 $\\dfrac{dx}{dt}$",
        "例：$x=t^2,\\ y=t^3$，$t=1$"
      ],
      "tex": [
        "\\frac{d^2y}{dx^2}=\\frac{dm}{dx}=\\frac{dm/dt}{dx/dt}",
        "\\frac{dy}{dx}=\\frac{3t^2}{2t}=\\frac{3t}{2}",
        "\\frac{d}{dt}\\Big(\\frac{3t}{2}\\Big)=\\frac32",
        "\\frac{d^2y}{dx^2}=\\frac{3/2}{2t}=\\frac{3}{4t}\\ \\xrightarrow{t=1}\\ \\frac34"
      ]
    },
    {
      "heading": "③ 不是兩個二階導數相除",
      "body": [
        "為什麼？對 $\\dfrac{y'}{x'}$ 用除法法則：",
        "再除以 $x'$：",
        "只有 $x''=0$ 時（例如 $x=t$），分子才只剩 $x'y''$",
        "驗算：$\\dfrac{2t\\cdot6t-3t^2\\cdot2}{8t^3}=\\dfrac{6t^2}{8t^3}=\\dfrac{3}{4t}$"
      ],
      "tex": [
        "\\frac{d^2y}{dx^2}\\ne\\frac{d^2y/dt^2}{d^2x/dt^2}",
        "\\frac{d}{dt}\\Big(\\frac{y'}{x'}\\Big)=\\frac{x'y''-y'x''}{(x')^2}",
        "\\frac{d^2y}{dx^2}=\\frac{x'y''-y'x''}{(x')^3}"
      ]
    },
    {
      "heading": "③ 例：擺線往哪邊彎",
      "body": [
        "$x=t-\\sin t,\\ y=1-\\cos t$，$0<t<2\\pi$",
        "分子 $=\\cos t-(\\cos^2t+\\sin^2t)=\\cos t-1$",
        "再除以 $\\dfrac{dx}{dt}=1-\\cos t$：",
        "整拱都凹向下；例如 $t=\\pi$：$-\\frac14$"
      ],
      "tex": [
        "\\frac{dy}{dx}=\\frac{\\sin t}{1-\\cos t}",
        "\\frac{d}{dt}\\Big(\\frac{dy}{dx}\\Big)=\\frac{\\cos t(1-\\cos t)-\\sin^2t}{(1-\\cos t)^2}",
        "=\\frac{-(1-\\cos t)}{(1-\\cos t)^2}=\\frac{-1}{1-\\cos t}",
        "\\frac{d^2y}{dx^2}=\\frac{-1}{(1-\\cos t)^2}<0"
      ]
    },
    {
      "heading": "③ 試一題",
      "body": [
        "曲線 $x=t^2,\\ y=t^3-3t$：",
        "分子永遠 $>0$：$t>0$ 凹向上，$t<0$ 凹向下"
      ],
      "tex": [
        "\\frac{dy}{dx}=\\frac{3t^2-3}{2t}=\\frac{3t}{2}-\\frac{3}{2t}",
        "\\frac{d}{dt}\\Big(\\frac{dy}{dx}\\Big)=\\frac32+\\frac{3}{2t^2}=\\frac{3(t^2+1)}{2t^2}",
        "\\frac{d^2y}{dx^2}=\\frac{3(t^2+1)}{2t^2}\\cdot\\frac{1}{2t}=\\frac{3(t^2+1)}{4t^3}"
      ]
    },
    {
      "heading": "④ 能消去參數，就驗算",
      "body": [
        "$x=t^2,\\ y=t^3$（$t>0$）：$t=\\sqrt x$，$y=x^{3/2}$",
        "$x=\\ln t,\\ y=t^2-1$，$t=1$",
        "驗算：$t=e^x$，$y=e^{2x}-1$"
      ],
      "tex": [
        "y''=\\frac34x^{-1/2}\\ \\xrightarrow{x=1}\\ \\frac34",
        "\\frac{dy}{dx}=\\frac{2t}{1/t}=2t^2",
        "\\frac{d^2y}{dx^2}=\\frac{4t}{1/t}=4t^2\\ \\xrightarrow{t=1}\\ 4",
        "y''=4e^{2x}=4t^2\\ \\Rightarrow\\ 4"
      ]
    },
    {
      "heading": "重點整理",
      "body": [
        "• 三步：一階導數 → 對 $t$ 微分 → 除以 $\\frac{dx}{dt}$",
        "• 不是 $\\dfrac{y''(t)}{x''(t)}$",
        "• 正：凹向上；負：凹向下",
        "• 能消去參數就驗算",
        "下一課：參數式弧長"
      ],
      "tex": [
        "\\frac{d^2y}{dx^2}=\\frac{\\frac{d}{dt}\\big(\\frac{dy}{dx}\\big)}{dx/dt}"
      ]
    }
  ],
  "workedExamples": [
