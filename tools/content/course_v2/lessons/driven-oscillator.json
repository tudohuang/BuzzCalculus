        "C=\\frac{F_0}{(\\omega_0^2-\\omega^2)+2i\\gamma\\omega}",
        "|C|=\\frac{F_0}{\\sqrt{(\\omega_0^2-\\omega^2)^2+(2\\gamma\\omega)^2}}",
        "\\tan\\delta=\\frac{2\\gamma\\omega}{\\omega_0^2-\\omega^2}"
