  "workedExamples": [
    {
      "title": "$x^3$：展開",
      "prompt": "用定義求 $f(x) = x^3$ 的導函數。",
      "steps": [
        "展開：$(x + h)^3 = x^3 + 3x^2h + 3xh^2 + h^3$。",
        "分子：$(x + h)^3 - x^3 = 3x^2h + 3xh^2 + h^3$，每一項都有 $h$。",
        "除以 $h$：$3x^2 + 3xh + h^2$。",
        "$h \\to 0$：後兩項 $\\to 0$，得 $f'(x) = 3x^2$。"
      ],
      "answer": "$3x^2$",
      "claim": "D(x^3) == 3x^2 ;; LIM(((2+x)^3-8)/x, 0) == 12"
    },
    {
      "title": "$\\frac{1}{x}$：通分",
      "prompt": "用定義求 $g(x) = \\frac{1}{x}$ 的導函數（$x \\ne 0$）。",
      "steps": [
        "差商：$(\\frac{1}{x + h} - \\frac{1}{x})/h$。",
        "分子通分：$\\frac{1}{x + h} - \\frac{1}{x} = \\frac{x - (x + h)}{x(x + h)} = -\\frac{h}{x(x + h)}$。",
        "除以 $h$：$-\\frac{1}{x(x + h)}$。",
        "$h \\to 0$：$-\\frac{1}{x \\cdot x} = -\\frac{1}{x^2}$。"
      ],
      "answer": "$-\\frac{1}{x^2}$",
      "claim": "D(1/x) == -1/x^2 ;; LIM((1/(2+x)-1/2)/x, 0) == -1/4"
    },
    {
      "title": "$\\sqrt{x}$：有理化",
      "prompt": "用定義求 $k(x) = \\sqrt{x}$ 的導函數（$x > 0$）。",
      "steps": [
        "差商：$\\frac{\\sqrt{x + h} - \\sqrt{x}}{h}$。根號相減，乘共軛 $\\sqrt{x + h} + \\sqrt{x}$。",
        "分子：$(\\sqrt{x + h} - \\sqrt{x})(\\sqrt{x + h} + \\sqrt{x}) = (x + h) - x = h$。",
        "式子變成 $\\frac{h}{h(\\sqrt{x + h} + \\sqrt{x})} = \\frac{1}{\\sqrt{x + h} + \\sqrt{x}}$。",
        "$h \\to 0$：$\\frac{1}{\\sqrt{x} + \\sqrt{x}} = \\frac{1}{2\\sqrt{x}}$。"
      ],
      "answer": "$\\frac{1}{2\\sqrt{x}}$",
      "claim": "D(sqrt(x)) == 1/(2*sqrt(x)) ;; LIM((sqrt(4+x)-2)/x, 0) == 1/4"
    }
  ],
