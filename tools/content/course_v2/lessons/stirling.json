        "\\ln\\frac{1+t}{1-t}=2\\left(t+\\frac{t^3}3+\\frac{t^5}5+\\cdots\\right)",
        "d_n-d_{n+1}=\\frac{t^2}3+\\frac{t^4}5+\\cdots",
        "\\begin{aligned}d_n-d_{n+1}&\\le\\frac{t^2}{3}(1+t^2+t^4+\\cdots)\\\\&=\\frac1{12n}-\\frac1{12(n+1)}\\end{aligned}"
