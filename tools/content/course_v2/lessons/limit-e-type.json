        "\\Big(1+\\frac1n\\Big)^n\\le\\sum_{k=0}^{n}\\frac1{k!}\\le1+1+\\frac12+\\frac14+\\cdots<3",
        "\\Rightarrow\\ \\lim_{n\\to\\infty}\\Big(1+\\frac1n\\Big)^n\\ \\text{存在}\\qquad\\blacksquare"
      ]
