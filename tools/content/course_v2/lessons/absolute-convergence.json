      "tex": [
        "\\left|\\frac{a_{n+1}}{a_n}\\right|=\\frac{n+1}{2^{n+1}}\\cdot\\frac{2^n}{n}=\\frac{n+1}{2n}",
        "L=\\lim_{n\\to\\infty}\\frac{n+1}{2n}=\\frac12<1",
        "\\text{所以}\\ \\sum_{n=1}^\\infty(-1)^{n+1}\\frac n{2^n}\\ \\text{絕對收斂}"
