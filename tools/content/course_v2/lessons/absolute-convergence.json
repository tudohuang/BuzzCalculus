        "0\\le a_n+|a_n|\\le2|a_n|",
        "a_n=(a_n+|a_n|)-|a_n|",
        "\\begin{aligned}\\sum a_n&=\\sum(a_n+|a_n|)-\\sum|a_n|\\\\&\\text{收斂}\\quad\\blacksquare\\end{aligned}"
      ]
