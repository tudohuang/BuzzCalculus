        "• 小的收斂 ⇏ 大的",
        "• 大的發散 ⇏ 小的"
      ],
      "tex": [
        "\\begin{aligned}&\\textstyle\\sum b_n\\ \\text{收斂}\\ \\Rightarrow\\ \\sum a_n\\ \\text{收斂}\\\\&\\textstyle\\sum a_n\\ \\text{發散}\\ \\Rightarrow\\ \\sum b_n\\ \\text{發散}\\end{aligned}"
      ]
    },
