  "workedExamples": [
    {
      "title": "猜一個根，拆成三個因式",
      "prompt": "分解 $p(x) = x^3 - 2x^2 - 5x + 6$",
      "steps": [
        "試常數項 6 的因數。$p(1) = 1 - 2 - 5 + 6 = 0$，所以 $(x - 1)$ 是因式。",
        "寫 $p(x) = (x - 1)(x^2 + bx + c)$。展開比較：常數項 $-c = 6$，$c = -6$；$x^2$ 項 $b - 1 = -2$，$b = -1$。檢查 $x$ 項：$c - b = -6 + 1 = -5$，對。",
        "$x^2 - x - 6 = (x - 3)(x + 2)$。",
        "$p(x) = (x - 1)(x - 3)(x + 2)$。"
      ],
      "answer": "$(x - 1)(x - 3)(x + 2)$",
      "claim": "x^3-2x^2-5x+6 == (x-1)(x-3)(x+2) ;; SUB(x^3-2x^2-5x+6, 1) == 0"
    },
    {
      "title": "洞還是漸近線",
      "prompt": "$r(x) = \\frac{x^2 - 4}{x^2 - x - 2}$：找定義域，判斷每個被排除的點是洞還是垂直漸近線。",
      "steps": [
        "分解：分子 $(x - 2)(x + 2)$，分母 $(x - 2)(x + 1)$。分母為 0 在 $x = 2$、$x = -1$，定義域是 $x \\ne 2$、$x \\ne -1$。",
        "$x = 2$：分子也是 0。約掉 $(x - 2)$，$x \\ne 2$ 時 $r(x) = \\frac{x + 2}{x + 1}$，這個式子在 2 的值是 $\\frac{4}{3}$，分母不是 0。$x = 2$ 是洞，洞在 $(2, \\frac{4}{3})$。",
        "$x = -1$：分子 $(-1)^2 - 4 = -3 \\ne 0$，分母 0。$x = -1$ 是垂直漸近線。"
      ],
      "answer": "定義域 $x \\ne 2$、$-1$；$x = 2$ 是洞，$x = -1$ 是垂直漸近線",
      "claim": "(x^2-4)/(x^2-x-2) == (x+2)/(x+1) ;; SUB((x+2)/(x+1), 2) == 4/3 ;; SUB(x^2-4, -1) == -3"
    },
    {
      "title": "首項決定遠方",
      "prompt": "$x$ 很大時，$r(x) = \\frac{3x^2 + 1}{x^2 - 5}$ 大約是多少？",
      "steps": [
        "首項：分子 $3x^2$，分母 $x^2$，比值 3。",
        "代 $x = 100$ 看看：$\\frac{30000 + 1}{10000 - 5} = \\frac{30001}{9995} \\approx 3.0016$。",
        "$x$ 越大越靠近 3。"
      ],
      "answer": "大約 3",
      "claim": "SUB((3x^2+1)/(x^2-5), 100) == 30001/9995 ;; LIM((3x^2+1)/(x^2-5), inf) == 3"
    }
  ],
