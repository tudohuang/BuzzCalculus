        {
          "label": "$80$",
          "why": "對數不是把真數相減"
        },
        {
          "label": "$27$",
          "why": "$27=3^3$ 是真數；要問的是「$3$ 的幾次方是 $81$」"
        }
      ]
    },
    {
      "ask": "哪一個式子對所有 $a,b>0$ 都成立？",
      "options": [
        {
          "label": "$\\ln(a^3b)=3\\ln a+\\ln b$",
          "correct": true
        },
        {
          "label": "$\\ln(a+b)=\\ln a\\cdot\\ln b$",
          "why": "和的對數沒有公式；$\\ln(1+1)=\\ln2\\ne0=\\ln1\\cdot\\ln1$"
        },
        {
          "label": "$(\\ln a)^3=3\\ln a$",
          "why": "$3\\ln a=\\ln(a^3)$；$(\\ln a)^3$ 是把對數值三次方"
        },
        {
          "label": "$\\dfrac{\\ln a}{\\ln b}=\\ln a-\\ln b$",
          "why": "相減對應的是 $\\ln\\frac ab$，不是兩個對數相除"
        }
      ]
    }
  ],
