      "tex": [
        "\\mathrm{B}(p,q)=\\int_0^1x^{p-1}(1-x)^{q-1}\\,dx",
        "1-x=\\cos^2\\theta,\\qquad dx=2\\sin\\theta\\cos\\theta\\,d\\theta",
        "x^{p-1}=\\sin^{2p-2}\\theta,\\qquad(1-x)^{q-1}=\\cos^{2q-2}\\theta",
        "\\mathrm{B}(p,q)=2\\int_0^{\\pi/2}\\sin^{2p-1}\\theta\\cos^{2q-1}\\theta\\,d\\theta",
        "\\begin{aligned}\\int_0^{\\pi/2}\\sin^{2p-1}\\theta\\cos^{2q-1}\\theta\\,d\\theta&=\\frac12\\mathrm{B}(p,q)\\\\&=\\frac{\\Gamma(p)\\Gamma(q)}{2\\,\\Gamma(p+q)}\\end{aligned}"
