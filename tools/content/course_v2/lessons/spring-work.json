  "objectives": [
    "用 Hooke 定律 $F=kx$，$x$ 從自然長度量起",
    "由給定的力或功先求出 $k$，再算 $W=\\int_a^b kx\\,dx=\\frac{1}{2}k(b^2-a^2)$",
    "題目給的是彈簧總長或公分時，正確換成伸長量（公尺）"
  ],
  "visual": null,
  "concept": [
    {
      "heading": "① Hooke 定律",
      "body": [
        "彈簧拉長 $x$，要用的力：",
        "$x$：從自然長度量起的伸長量（不是彈簧總長）",
        "$k$：彈性係數，單位 N/m；越硬的彈簧 $k$ 越大"
      ],
      "tex": [
        "F(x)=kx"
      ]
    },
    {
      "heading": "② 功是 F–x 圖下的面積",
      "body": [
        "從伸長 $a$ 拉到伸長 $b$：",
        "從自然長度開始（$a=0$）：$W=\\frac12kb^2$",
        "三角形：$\\frac12\\cdot b\\cdot kb=\\frac12kb^2$，不用積分也算得出來"
      ],
      "tex": [
        "W=\\int_a^b kx\\,dx=\\Big[\\frac12kx^2\\Big]_a^b",
        "W=\\frac12k\\,(b^2-a^2)"
      ]
    },
    {
      "heading": "③ 先求 k：給力",
      "body": [
        "彈簧受力 $10$ N 時伸長 $0.2$ m。從自然長度拉長 $0.3$ m，需作多少功？",
        "常見錯法：$W=F\\times d=10\\times0.3=3$ J",
        "力是變的：先求 $k$，再積分"
      ],
      "tex": [
        "10=k\\cdot0.2\\ \\Rightarrow\\ k=50\\ \\text{N/m}",
        "W=\\int_0^{0.3}50x\\,dx=25(0.3)^2=2.25\\ \\text{J}"
      ]
    },
    {
      "heading": "③ 先求 k：給功",
      "body": [
        "從自然長度拉長 $0.1$ m 需作功 $2$ J。再從伸長 $0.1$ m 拉到 $0.2$ m，需再作多少功？"
      ],
      "tex": [
        "2=\\frac12k(0.1)^2\\ \\Rightarrow\\ k=400\\ \\text{N/m}",
        "\\begin{aligned}W&=\\int_{0.1}^{0.2}400x\\,dx\\\\&=200\\,(0.04-0.01)=6\\ \\text{J}\\end{aligned}"
      ]
    },
    {
      "heading": "③ 給總長：先換成伸長量",
      "body": [
        "自然長度 $20$ cm。用 $40$ N 可把它維持在 $30$ cm 長。從 $30$ cm 拉到 $35$ cm，需作多少功？",
        "換成伸長量、公尺：",
        "• $30$ cm → $x=0.10$ m",
        "• $35$ cm → $x=0.15$ m"
      ],
      "tex": [
        "40=k\\cdot0.1\\ \\Rightarrow\\ k=400\\ \\text{N/m}",
        "\\begin{aligned}W&=\\int_{0.1}^{0.15}400x\\,dx\\\\&=200\\,(0.15^2-0.1^2)=2.5\\ \\text{J}\\end{aligned}"
      ]
    },
    {
      "heading": "④ 壓縮、位能與適用範圍",
      "body": [
        "壓縮也一樣：壓縮 $x$ 公尺，力 $kx$，功 $\\frac12kx^2$",
        "把 $x$ 設成負的（往內）也行：$\\int_0^{-c}kx\\,dx=\\frac12kc^2$，平方讓正負號消失",
        "例：$k=400$ N/m，從自然長度壓縮 $5$ cm",
        "作的功存成彈性位能：",
        "適用範圍：只在彈性限度內成立",
        "解題三步：",
        "1. 換成伸長量（公尺）",
        "2. 由給的力或功求 $k$",
        "3. $W=\\frac12k(b^2-a^2)$"
      ],
      "tex": [
        "W=\\int_0^{0.05}400x\\,dx=200(0.05)^2=0.5\\ \\text{J}",
        "U=\\frac12kx^2"
      ]
    },
    {
      "heading": "重點整理",
      "body": [
        "• Hooke：$F=kx$，$x$ 是伸長量（從自然長度量）",
        "• 功：$W=\\int_a^b kx\\,dx=\\frac12k(b^2-a^2)$，是 $F$–$x$ 圖下的面積",
        "• 先求 $k$：給力用 $F=kx$，給功用 $W=\\frac12kx^2$",
        "• 總長、公分：先換成伸長量、公尺",
        "• 壓縮一樣算；功存成位能 $\\frac12kx^2$",
        "下一課：液體壓力"
      ]
    }
  ],
  "workedExamples": [
    {
      "title": "給力求功",
      "prompt": "彈簧受力 10 N 時伸長 0.2 m（遵守 Hooke 定律）。把它從自然長度拉長 0.3 m 需作功幾焦耳？",
      "problemId": "lec-10-m5",
      "steps": [
        "$k=\\frac{10}{0.2}=50$（N/m）。",
        "$W=\\int_0^{0.3}50x\\,dx=\\frac{1}{2}\\cdot\\, 50\\cdot 0.3^2=25\\cdot 0.09=2.25$（J）。"
      ],
      "answer": "2.25 J",
      "claim": "INT(50x, 0, 0.3) == 2.25"
    },
    {
      "title": "給功求 $k$，再算後面一段",
      "prompt": "把彈簧從自然長度拉長 0.1 m 需作功 2 J。再從伸長 0.1 m 拉到伸長 0.2 m，需再作多少功？",
      "problemId": "lec-10-q3a",
      "steps": [
        "$\\frac{1}{2}k(0.1)^2=2$，$0.005k=2$，$k=400$（N/m）。",
        "$W=\\int_{0.1}^{0.2}400x\\,dx=200(0.2^2-0.1^2)=200\\cdot 0.03=6$（J）。",
        "後面這 0.1 m 要 6 J，是前面 0.1 m 的三倍。"
      ],
      "answer": "6 J",
      "claim": "INT(400x, 0, 0.1) == 2 ;; INT(400x, 0.1, 0.2) == 6"
    },
    {
      "title": "給總長：先換成伸長量",
      "prompt": "彈簧自然長度 20 cm。用 40 N 的力可以把它維持在 30 cm 長。把它從 30 cm 拉到 35 cm 需作多少功？",
      "steps": [
        "換成伸長量（公尺）：30 cm 對應 $x=0.10$ m，35 cm 對應 $x=0.15$ m。",
        "$k=\\frac{40}{0.10}=400$（N/m）。",
        "$W=\\int_{0.10}^{0.15}400x\\,dx=200(0.15^2-0.10^2)=200\\cdot 0.0125=2.5$（J）。"
      ],
      "answer": "2.5 J",
      "claim": "INT(400x, 0.1, 0.15) == 2.5"
    }
  ],
  "pitfalls": [
    "把彈簧的總長當成 $x$。",
    "公分沒換成公尺，$k$ 和功差了一百倍以上。",
    "拿最後的力乘距離：力從小變大，從自然長度拉起時這樣會多算一倍。",
    "給的是功卻用 $W/x$ 求 $k$。",
    "以為每多拉 0.1 m 需要的功都一樣。"
  ],
