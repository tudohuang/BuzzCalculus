    {
      "ask": "x ≠ 3 時，(3 − x)/(x − 3) 等於？",
      "options": [
        { "label": "−1", "correct": true },
        { "label": "1", "why": "3 − x = −(x − 3)，約完留下一個負號。" },
        { "label": "0", "why": "分子分母都不是 0（x ≠ 3），比值是 −1。" }
      ]
    },
    {
      "ask": "lim_{h→0} ((1 + h)² − 1)/h 是？",
