        { "label": "$e^{5x}+C$", "why": "$(e^{5x})'=5e^{5x}$，多了 $5$，要除掉。" }
      ]
    },
    {
      "ask": "$\\int\\frac{1}{2x+1}\\,dx$ 是？",
      "options": [
