        "\\frac{1}{\\cos^2x}-\\frac{\\sin x}{\\cos^2x}=\\sec^2x-\\sec x\\tan x",
        "\\int\\frac{dx}{1+\\sin x}=\\tan x-\\sec x+C",
        "\\begin{aligned}(\\tan x-\\sec x)'&=\\sec^2x-\\sec x\\tan x\\\\&=\\frac{1-\\sin x}{\\cos^2x}=\\frac1{1+\\sin x}\\end{aligned}"
