        "\\frac{\\sqrt{9+h}-3}{h}\\cdot\\frac{\\sqrt{9+h}+3}{\\sqrt{9+h}+3}=\\frac{1}{\\sqrt{9+h}+3}",
        "f'(9)=\\frac1{3+3}=\\frac16"
      ]
