  "workedExamples": [
    {
      "title": "條件在 $x=0$",
      "prompt": "$y'=-2y$，$y(0)=5$。",
      "problemId": "cx-ode-002",
      "steps": [
        "$y'=ky$ 的解是 $Ce^{kx}$，這裡 $k=-2$：$y=Ce^{-2x}$。",
        "代 $x=0$：$5=Ce^0=C$。",
        "$y=5e^{-2x}$。指數部分處處有定義，解在整條數線上都存在。"
      ],
      "answer": "$y=5e^{-2x}$",
      "claim": "D(5*e^(-2x)) == -2*(5*e^(-2x)) ;; SUB(5*e^(-2x),0) == 5"
    },
    {
      "title": "條件不在 $0$",
      "prompt": "$y'=3y$，$y(1)=2$。",
      "steps": [
        "一族解：$y=Ce^{3x}$。",
        "代 $x=1$：$2=Ce^3$，所以 $C=\\frac{2}{e^3}=2e^{-3}$。",
        "$y=2e^{-3}\\cdot e^{3x}=2e^{3(x-1)}$。",
        "檢查：$x=1$ 時 $2e^0=2$。"
      ],
      "answer": "$y=2e^{3(x-1)}$",
      "claim": "D(2*e^(3(x-1))) == 3*(2*e^(3(x-1))) ;; SUB(2*e^(3(x-1)),1) == 2"
    },
    {
      "title": "會爆破的解",
      "prompt": "驗證 $y=\\frac{1}{1-x}$ 是 $y'=y^2$、$y(0)=1$ 的解，並求它存在的區間。",
      "problemId": "ode-sep-003",
      "steps": [
        "$y=(1-x)^{-1}$，$y'=-(1-x)^{-2}\\cdot(-1)=\\frac{1}{(1-x)^2}$。",
        "$y^2=\\frac{1}{(1-x)^2}$，和 $y'$ 相同。$y(0)=\\frac{1}{1}=1$。",
        "$x=1$ 時分母為 $0$。含 $x=0$ 而且沒有斷點的最大區間是 $(-\\infty,1)$。",
        "$x\\to1^-$ 時 $y\\to+\\infty$：解在 $x=1$ 之前就爆破了。"
      ],
      "answer": "$y=\\frac{1}{1-x}$，$x<1$",
      "claim": "D(1/(1-x)) == (1/(1-x))^2 ;; SUB(1/(1-x),0) == 1"
    },
    {
      "title": "x 靠近 1",
      "prompt": "$y=\\frac{1}{1-x}$，代 $x=0.5$、$0.9$、$0.99$。",
      "steps": [
        "$x=0.5$：$1-x=0.5$，$y=2$。",
        "$x=0.9$：$1-x=0.1$，$y=10$。",
        "$x=0.99$：$1-x=0.01$，$y=100$。",
        "分母越小，$y$ 越大，沒有上限。"
      ],
      "answer": "$y=2,\\ 10,\\ 100$，越來越大",
      "claim": "SUB(1/(1-x),0.5) == 2 ;; SUB(1/(1-x),0.9) == 10 ;; SUB(1/(1-x),0.99) == 100"
    }
  ],
  "pitfalls": [
    "條件給 $y(1)=2$，卻直接寫 $C=2$。",
    "忘了寫區間：$y=\\frac{1}{1-x}$ 這個初值問題的解只在 $x<1$。",
    "二階方程只用一個條件，留下一個沒定的常數。",
    "先代條件再積分：要先得到帶常數的一族解，最後才代條件。"
