        "=-\\frac{\\ln t}{t}+1-\\frac1t",
        "\\ln t=\\int_1^t\\frac{ds}{s}\\le\\int_1^t\\frac{ds}{\\sqrt s}=2\\sqrt t-2<2\\sqrt t",
        "\\int_1^{\\infty}\\frac{\\ln x}{x^2}\\,dx=\\lim_{t\\to\\infty}\\Big(1-\\frac1t-\\frac{\\ln t}t\\Big)=1"
      ]
