        "\\int x\\,dx=\\frac{x^2}{2},\\quad\\int\\frac{x}{x^2+1}\\,dx=\\frac12\\ln(x^2+1)",
        "\\int\\frac{x^3}{x^2+1}\\,dx=\\frac{x^2}{2}-\\frac12\\ln(x^2+1)+C"
      ]
