      "tex": [
        "\\begin{aligned}&\\int\\frac{2x+5}{x^2+2x+5}\\,dx\\\\&=\\ln(x^2+2x+5)+\\frac32\\arctan\\frac{x+1}{2}+C\\end{aligned}"
      ]
    },
    {
      "heading": "④ 別忘了第零步",
