        "\\frac{fg}{h}=\\underbrace{\\frac{f}{f_1}}_{\\to1}\\cdot\\underbrace{\\frac{g}{g_1}}_{\\to1}\\cdot\\underbrace{\\frac{h_1}{h}}_{\\to1}\\cdot\\frac{f_1g_1}{h_1}",
        "\\lim_{x\\to0}\\frac{\\sin3x\\cdot\\ln(1+2x)}{x\\,(e^x-1)}",
