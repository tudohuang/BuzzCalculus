  "workedExamples": [
    {
      "title": "跨過 $x$ 軸的直線",
      "prompt": "求 $\\int_{-1}^{2}x\\,dx$，並和 $\\int_{-1}^{2}|x|\\,dx$ 比較。",
      "steps": [
        "$y=x$ 在 $x=0$ 穿過 $x$ 軸。$[-1,0]$ 那塊在下方：直角三角形，兩股都是 $1$，面積 $\\frac{1}{2}$，算 $-\\frac{1}{2}$。",
        "$[0,2]$ 那塊在上方：直角三角形，兩股都是 $2$，面積 $2$，算 $+2$。",
        "$\\int_{-1}^{2}x\\,dx=2-\\frac{1}{2}=\\frac{3}{2}$。",
        "$\\int_{-1}^{2}|x|\\,dx$ 兩塊都算正的：$2+\\frac{1}{2}=\\frac{5}{2}$。"
      ],
      "answer": "$\\int_{-1}^{2}x\\,dx=\\frac{3}{2}$；$\\int_{-1}^{2}|x|\\,dx=\\frac{5}{2}$",
      "claim": "INT(x,-1,2) == 3/2 ;; INT(abs(x),-1,2) == 5/2"
    },
    {
      "title": "半圓",
      "prompt": "$\\int_{-2}^{2}\\sqrt{4-x^2}\\,dx$",
      "steps": [
        "$y=\\sqrt{4-x^2}$ 兩邊平方得 $x^2+y^2=4$，而且 $y\\ge 0$：這是半徑 $2$ 的圓的上半部。",
        "$x$ 從 $-2$ 到 $2$ 剛好是整個上半圓，而且全部在 $x$ 軸上方，算正的。",
        "面積 $=\\frac{1}{2}\\cdot\\pi\\cdot 2^2=2\\pi$。"
      ],
      "answer": "$2\\pi$",
      "claim": "INT(sqrt(4-x^2),-2,2) == 2*pi"
    },
    {
      "title": "位移與總路程",
      "prompt": "物體速度 $v(t)=2-t$（公尺／秒），$0\\le t\\le 4$。求位移與總路程。",
      "steps": [
        "$v$ 在 $t=2$ 由正變負：前 2 秒往前走，後 2 秒往回走。",
        "$[0,2]$：三角形底 $2$、高 $2$，面積 $2$，在上方，算 $+2$。",
        "$[2,4]$：三角形底 $2$、高 $2$，面積 $2$，在下方，算 $-2$。",
        "位移 $=\\int_0^4 v\\,dt=2-2=0$（回到原點）；總路程 $=\\int_0^4|v|\\,dt=2+2=4$ 公尺。"
      ],
      "answer": "位移 $0$ 公尺；總路程 $4$ 公尺",
      "claim": "INT(2-t,0,4,t) == 0 ;; INT(abs(2-t),0,4,t) == 4"
    }
