      ],
      "tex": [
        "\\sum_{n=1}^{\\infty}(a_n\\pm b_n)=A\\pm B,\\qquad \\sum_{n=1}^{\\infty}c\\,a_n=cA",
        "\\sum_{k=1}^{n}(a_k+b_k)=s_n+t_n\\ \\to\\ A+B"
      ]
