      "tex": [
        "\\Gamma(p)\\Gamma(1-p)=\\mathrm{B}(p,1-p)=\\int_0^\\infty\\frac{t^{p-1}}{1+t}\\,dt",
        "\\Gamma(p)\\,\\Gamma(1-p)=\\frac{\\pi}{\\sin\\pi p}"
      ]
    },
