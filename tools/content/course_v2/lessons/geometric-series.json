  "visual": null,
  "concept": [
    {
      "heading": "① 每一項乘同一個數",
      "body": [
        "幾何級數：首項 $a$，每一項乘上公比 $r$",
        "例：$\\dfrac12+\\dfrac14+\\dfrac18+\\cdots$：$a=\\dfrac12$，$r=\\dfrac12$",
        "例：$0.333\\dots=\\dfrac3{10}+\\dfrac3{100}+\\cdots$：$a=\\dfrac3{10}$，$r=\\dfrac1{10}$",
        "認公比：後一項 ÷ 前一項",
        "首項 = 第一個真的被加進去的項"
      ],
      "tex": [
        "a+ar+ar^2+ar^3+\\cdots=\\sum_{n=0}^{\\infty}ar^n",
        "r=\\frac{a_{n+1}}{a_n}\\quad\\text{（每一對都一樣）}"
      ]
    },
    {
      "heading": "② 部分和有公式",
      "body": [
        "兩邊乘 $r$：",
        "相減：中間全部消掉",
        "$r\\ne1$ 時除以 $1-r$：",
        "驗算：$a=\\frac12,r=\\frac12,n=3$：$\\frac{\\frac12\\cdot\\frac78}{\\frac12}=\\frac78$，正是 $\\frac12+\\frac14+\\frac18$",
        "$r=1$：每一項都是 $a$，$s_n=na$"
      ],
      "tex": [
        "s_n=a+ar+ar^2+\\cdots+ar^{n-1}",
        "rs_n=ar+ar^2+\\cdots+ar^{n-1}+ar^n",
        "s_n-rs_n=a-ar^n",
        "s_n=\\frac{a(1-r^n)}{1-r}\\qquad(r\\ne1)"
      ]
    },
    {
      "heading": "③ 收斂的條件",
      "body": [
        "6.1 學過：$|r|<1$ 時 $r^n\\to0$",
        "$|r|\\ge1$（$a\\ne0$）：都發散",
        "• $r=1$：$s_n=na\\to\\pm\\infty$",
        "• $r=-1$：$s_n=a,0,a,0,\\dots$ 一直跳",
        "• $|r|>1$：$|r^n|\\to\\infty$，$s_n$ 沒有極限"
      ],
      "tex": [
        "s_n=\\frac{a}{1-r}-\\frac{a}{1-r}\\,r^n",
        "\\lim_{n\\to\\infty}s_n=\\frac{a}{1-r}\\qquad(|r|<1)",
        "\\sum_{n=0}^\\infty ar^n\\ \\text{收斂}\\iff|r|<1"
      ]
    },
    {
      "heading": "③ 看部分和怎麼走",
      "body": [
        "$r=0.8$：還是收斂，但爬得比較慢",
        "$r<0$：一上一下，夾著 $\\frac1{1-r}$",
        "$r=1.1$：衝出畫面，發散"
      ]
    },
    {
      "heading": "④ 實用口訣",
      "body": [
        "例：拆成兩個幾何級數 $\\displaystyle\\sum_{n=1}^{\\infty}\\frac{3^n+2^n}{6^n}$",
        "首項是 $n=1$ 那一項：",
        "拆開之前先確認兩個都收斂（上上一課的規則）"
      ],
      "tex": [
        "\\text{和}=\\frac{\\text{首項}}{1-\\text{公比}}\\qquad(|\\text{公比}|<1)",
        "=\\sum_{n=1}^{\\infty}\\Big(\\frac12\\Big)^n+\\sum_{n=1}^{\\infty}\\Big(\\frac13\\Big)^n",
        "=\\frac{\\frac12}{1-\\frac12}+\\frac{\\frac13}{1-\\frac13}=1+\\frac12=\\frac32"
      ]
    },
    {
      "heading": "④ 循環小數化分數",
      "body": [
        "首項 $\\frac{12}{100}$，公比 $\\frac1{100}$：",
        "驗算：$4\\div33=0.121212\\dots$；國中的「循環節 ÷ 99」就是這個公式"
      ],
      "tex": [
        "0.121212\\dots=\\frac{12}{100}+\\frac{12}{100^2}+\\cdots",
        "=\\frac{\\frac{12}{100}}{1-\\frac1{100}}=\\frac{12}{99}=\\frac4{33}"
      ]
    },
    {
      "heading": "④ 陷阱：$|r|\\ge1$",
      "body": [
        "$s_n=2^n-1\\to\\infty$，發散",
        "先看 $|r|<1$，再用公式",
        "例：公比裡有 $x$",
        "這些 $x$：和 $=\\dfrac{1}{1-\\frac{x-1}2}=\\dfrac2{3-x}$",
        "驗算：$x=2$：$\\sum\\frac1{2^n}=2=\\frac2{3-2}$"
      ],
      "tex": [
        "\\sum_{n=0}^{\\infty}\\frac{(x-1)^n}{2^n}=\\sum_{n=0}^\\infty\\Big(\\frac{x-1}2\\Big)^n",
        "\\Big|\\frac{x-1}2\\Big|<1\\iff|x-1|<2\\iff-1<x<3"
      ]
    },
    {
      "heading": "重點整理",
      "body": [
        "• $s_n=\\dfrac{a(1-r^n)}{1-r}$：乘 $r$、相減，中間消掉",
        "• $|r|<1$：$r^n\\to0$，和 $=\\dfrac{a}{1-r}$",
        "• $|r|\\ge1$（$a\\ne0$）：發散，不能套公式",
        "• 首項看起始指標：$n=0,1,2$ 首項都不同",
        "• 循環小數、拆項、公比含 $x$：都是同一個公式",
        "下一課：望遠鏡級數"
      ]
    }
  ],
  "workedExamples": [
    {
      "title": "拆成兩個幾何級數",
      "prompt": "求 $\\sum_{n=1}^{\\infty}\\frac{3^n+2^n}{6^n}$。",
      "problemId": "lec-12-q1a",
      "steps": [
        "拆開：$\\frac{3^n+2^n}{6^n}=\\left(\\frac{1}{2}\\right)^n+\\left(\\frac{1}{3}\\right)^n$。兩個都是 $|r|<1$ 的幾何級數，各自收斂，可以分開加。",
        "$\\sum_{n=1}^{\\infty}\\left(\\frac{1}{2}\\right)^n$：首項 $\\frac{1}{2}$，和 $=\\frac{1/2}{1-1/2}=1$。",
        "$\\sum_{n=1}^{\\infty}\\left(\\frac{1}{3}\\right)^n$：首項 $\\frac{1}{3}$，和 $=\\frac{1/3}{1-1/3}=\\frac{1}{2}$。",
        "總和 $=1+\\frac{1}{2}=\\frac{3}{2}$。"
      ],
      "answer": "$\\frac{3}{2}$",
      "claim": "SUM((3^n+2^n)/6^n, 1) == 3/2"
    },
    {
      "title": "循環小數化分數",
