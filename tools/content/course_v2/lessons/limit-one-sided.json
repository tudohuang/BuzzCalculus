    {
      "title": "絕對值除以自己",
      "prompt": "求 $\\lim_{x\\to0^-} |x|/x$ 與 $\\lim_{x\\to0^+} |x|/x$",
      "steps": [
        "右邊 $x > 0$：$|x| = x$，$|x|/x = 1$，所以右極限是 1。",
        "左邊 $x < 0$：$|x| = -x$，$|x|/x = -\\frac{x}{x} = -1$，所以左極限是 $-1$。",
        "$x = 0$ 本身沒有定義，但這不影響左右極限。"
      ],
      "answer": "左極限 $-1$，右極限 1",
      "claim": "LIM(abs(x)/x, 0-) == -1 ;; LIM(abs(x)/x, 0+) == 1"
    },
    {
      "title": "分段函數的分界點",
      "prompt": "$f(x) = x^2 + 1$（$x < 1$），$2x + 3$（$x \\ge 1$）。求 $\\lim_{x\\to1^-} f(x)$、$\\lim_{x\\to1^+} f(x)$、$f(1)$。",
      "steps": [
        "左極限：$x < 1$ 用 $x^2 + 1$。$x$ 靠近 1 時靠近 $1 + 1 = 2$。",
        "右極限：$x > 1$ 用 $2x + 3$。$x$ 靠近 1 時靠近 $2 + 3 = 5$。",
        "$f(1)$：1 屬於 $x \\ge 1$ 那段，$f(1) = 5$。剛好跟右極限一樣，跟左極限不一樣。"
      ],
      "answer": "左極限 2，右極限 5，$f(1) = 5$",
      "claim": "LIM(x^2+1, 1-) == 2 ;; LIM(2x+3, 1+) == 5 ;; SUB(2x+3, 1) == 5"
    },
