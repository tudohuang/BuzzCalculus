      ],
      "answer": "$\\frac{\\ln 2}{2}$ 與 $\\frac{\\pi}{4}$",
      "claim": "INT(x/(1+x^2), 0, 1) == ln(2)/2 ;; INT(1/(1+x^2), 0, 1) == pi/4"
    }
