      "options": [
        {
          "label": "$-1<r\\le 1$",
          "correct": true
        },
        {
          "label": "$|r|<1$",
          "why": "漏了 $r=1$：$1^n$ 每一項都是 1，收斂到 1。"
        },
        {
          "label": "$-1\\le r\\le 1$",
          "why": "$r=-1$ 時 $(-1)^n$ 在 $-1$ 與 1 之間跳，不收斂。"
        }
      ]
    },
    {
      "ask": "$a_n=\\sin(\\pi n)$，$\\lim a_n$ 是？",
      "options": [
        {
          "label": "0",
