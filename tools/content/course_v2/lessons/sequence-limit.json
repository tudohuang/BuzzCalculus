    {
      "ask": "$\\displaystyle\\lim_{n\\to\\infty}\\frac{n^2}{e^n}=$？",
      "options": [
        {
          "label": "$0$",
          "correct": true
        },
        {
          "label": "$\\infty$",
          "why": "分子分母都 $\\to\\infty$，但 $e^n$ 長得快得多"
        },
        {
          "label": "$1$",
          "why": "$\\frac\\infty\\infty$ 不代表比值是 $1$，要比誰長得快"
        },
        {
          "label": "$2$",
          "why": "微分兩次後分子是 $2$，但分母 $e^x$ 還在，要再取極限"
