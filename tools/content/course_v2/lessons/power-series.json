  "workedExamples": [
    {
      "title": "中心不在 0",
      "prompt": "$\\sum_{n=0}^\\infty\\frac{(x+2)^n}{3^n}$ 在哪些 $x$ 收斂？和是多少？",
      "steps": [
        "寫成 $\\sum\\left(\\frac{x+2}{3}\\right)^n$，中心 $a=-2$，公比 $u=\\frac{x+2}{3}$。",
        "收斂 $\\Leftrightarrow|x+2|<3\\Leftrightarrow-5<x<1$。",
        "和 $=\\frac{1}{1-(x+2)/3}=\\frac{3}{3-x-2}=\\frac{3}{1-x}$。",
        "檢查 $x=-1$：級數是 $\\sum\\left(\\frac{1}{3}\\right)^n=\\frac{3}{2}$，而 $\\frac{3}{1-(-1)}=\\frac{3}{2}$。"
      ],
      "answer": "$-5<x<1$ 時收斂，和為 $\\frac{3}{1-x}$",
      "claim": "SUB(SUM(((x+2)/3)^n, 0), -1) == SUB(3/(1-x), -1) ;; SUB(SUM(((x+2)/3)^n, 0), -4) == SUB(3/(1-x), -4)"
    },
    {
      "title": "代換 $u=-x^2$",
      "prompt": "寫出 $\\frac{1}{1+x^2}$ 的冪級數，以及它成立的範圍。",
      "problemId": "lec-14-m4",
      "steps": [
        "$\\frac{1}{1+x^2}=\\frac{1}{1-(-x^2)}$，令 $u=-x^2$。",
        "$=\\sum(-x^2)^n=\\sum(-1)^n x^{2n}=1-x^2+x^4-x^6+\\cdots$。",
        "條件 $|-x^2|<1$，即 $|x|<1$。注意 $\\frac{1}{1+x^2}$ 對所有實數都有定義，但這個級數只在 $(-1,1)$ 收斂。"
      ],
      "answer": "$\\sum(-1)^n x^{2n}$，$|x|<1$",
      "claim": "SUB(SUM((-1)^n*x^(2n), 0), 0.5) == SUB(1/(1+x^2), 0.5)"
    },
    {
      "title": "先湊出 $1-u$",
      "prompt": "寫出 $\\frac{x}{4+x^2}$ 的冪級數，以及它成立的範圍。",
      "problemId": "lec-14-q2a",
      "steps": [
        "分母提出 4：$\\frac{x}{4+x^2}=\\frac{x}{4}\\cdot\\frac{1}{1+x^2/4}=\\frac{x}{4}\\cdot\\frac{1}{1-(-x^2/4)}$。",
        "$u=-\\frac{x^2}{4}$：$=\\frac{x}{4}\\sum(-1)^n\\frac{x^{2n}}{4^n}=\\sum(-1)^n\\frac{x^{2n+1}}{4^{n+1}}$。",
        "條件 $\\left|\\frac{x^2}{4}\\right|<1$，即 $|x|<2$。"
      ],
      "answer": "$\\sum(-1)^n\\frac{x^{2n+1}}{4^{n+1}}$，$|x|<2$",
      "claim": "SUB(SUM((-1)^n*x^(2n+1)/4^(n+1), 0), 1.5) == SUB(x/(4+x^2), 1.5)"
    }
