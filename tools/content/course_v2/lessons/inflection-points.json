  "workedExamples": [
    {
      "title": "偶次多項式",
      "prompt": "求 $f(x)=x^4-6x^2$ 的反曲點。",
      "problemId": "si-set-017",
      "steps": [
        "$f'(x)=4x^3-12x$，$f''(x)=12x^2-12=12(x-1)(x+1)$。",
        "候選點：$x=-1$、$x=1$（$f''$ 處處存在）。",
        "$x<-1$：$f''>0$。$-1<x<1$：$f''<0$。$x>1$：$f''>0$。兩個候選點都換號。",
        "$f(\\pm 1)=1-6=-5$。反曲點是 $(-1,-5)$ 與 $(1,-5)$。"
      ],
      "answer": "$(-1,-5)$、$(1,-5)$",
      "claim": "D2(x^4-6x^2) == 12*(x-1)*(x+1) ;; D2(x^4-6x^2, -2) > 0 ;; D2(x^4-6x^2, 0) < 0 ;; D2(x^4-6x^2, 2) > 0 ;; SUB(x^4-6x^2, 1) == -5"
    },
    {
      "title": "只給 $f'$",
      "prompt": "某函數的導函數是 $f'(x)=(x+2)(x-1)^2$。求 $f$ 所有反曲點的 $x$ 座標。",
      "problemId": "lec-04-q4c",
      "steps": [
        "對 $f'$ 用乘法法則：$f''(x)=(x-1)^2+(x+2)\\cdot 2(x-1)$。",
        "提出 $(x-1)$：$f''(x)=(x-1)((x-1)+2(x+2))=(x-1)(3x+3)=3(x-1)(x+1)$。",
        "$f''$ 在 $x=-1$、$x=1$ 都是一次因式的零點，兩側換號。",
        "反曲點在 $x=-1$ 與 $x=1$。"
      ],
      "answer": "$x=-1$、$x=1$",
      "note": "$x=1$ 同時是臨界點（$f'(1)=0$）和反曲點：切線水平，曲線穿過切線，所以不是極值。",
      "claim": "D((x+2)*(x-1)^2) == 3*(x-1)*(x+1) ;; D((x+2)*(x-1)^2, 0) < 0 ;; D((x+2)*(x-1)^2, 2) > 0 ;; D((x+2)*(x-1)^2, -2) > 0"
    },
    {
      "title": "$f''$ 不存在的反曲點",
      "prompt": "$f(x)=\\sqrt[3]{x}=x^{1/3}$。原點是不是反曲點？",
      "steps": [
        "$x\\ne 0$ 時：$f'(x)=\\frac{1}{3}x^{-2/3}$，$f''(x)=-\\frac{2}{9}x^{-5/3}$。在 $x=0$ 這兩個式子都沒有意義，$f''(0)$ 不存在。",
        "$x>0$：$x^{-5/3}>0$，$f''<0$，凹向下。$x<0$：$x^{-5/3}=\\frac{1}{(\\sqrt[3]{x})^5}<0$，$f''>0$，凹向上。",
        "$\\sqrt[3]{x}$ 在 $0$ 連續，凹性在 $0$ 改變，所以原點 $(0,0)$ 是反曲點。"
      ],
      "answer": "是，原點是反曲點",
      "claim": "D(x^(1/3)) == (1/3)*x^(-2/3) ;; D2(x^(1/3)) == -2/9*x^(-5/3)"
    }
  ],
  "pitfalls": [
    "解出 $f''=0$ 就宣布是反曲點，沒有檢查換號（$x^4$ 的 $0$）。",
    "只找 $f''=0$，漏掉 $f''$ 不存在的點（$\\sqrt[3]{x}$ 的 $0$）。",
    "把不在定義域的點也算成反曲點（$\\frac{x^2}{x-1}$ 的 $1$）。",
    "把 $f'=0$ 的點當成反曲點候選；那是極值的候選。"
  ],
